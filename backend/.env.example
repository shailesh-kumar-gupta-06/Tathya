APP_ENV=development
DATA_DIR=./data
MAX_UPLOAD_MB=20
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Language model (open-source, via Ollama). If unreachable, Tathya runs in extractive mode.
USE_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT=120

# Optional dense retrieval (requires requirements-ml.txt)
EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Abstention strictness: share of question terms a passage must contain (0 to 1)
MIN_COVERAGE=0.6
